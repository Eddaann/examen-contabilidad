# Opcional para Docker Compose: funciona sin crear un .env.
# Valores locales de ejemplo; no utilizar en producción.
POSTGRES_USER=examen
POSTGRES_PASSWORD=examen_local
POSTGRES_DB=examen_contabilidad
DB_PUBLISHED_PORT=5432
FRONTEND_PORT=8080

# Para ejecutar el backend fuera de Docker desde backend/.
PORT=3000
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=coloca_una_clave_segura

# Contraseñas privadas para cuentas de prueba (12 a 128 caracteres).
TEST_STUDENT_PASSWORD=
TEST_TEACHER_PASSWORD=

# Sin proxy al ejecutar Node directamente. Compose configura su único proxy.
TRUST_PROXY=0
